+    fn present_with_damage(
+        &self,
+        detail: &dispatch::DispatchSurfaceOutputDetail,
+        damage_rects: &[wgt::DamageRect],
+    ) {
+        let detail = detail.as_core();
+        match self
+            .context
+            .0
+            .surface_present_with_damage(detail.surface_id, damage_rects)
+        {
+            Ok(_status) => (),
+            Err(err) => {
+                self.context.handle_error_nolabel(
+                    &self.error_sink,
+                    err,
+                    "Queue::present_with_damage",
+                );
+            }
+        }
+    }
 }
 
