PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://mail:mail@localhost:5441/mail
# Seals the provider credentials kept in Postgres. Any long random text; never change it.
SECRET_KEY=change-me
# From the Google Cloud console (README.md: Google OAuth client). Without them Gmail is off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# From the Microsoft Entra admin center (README.md: Register the app with Microsoft). Without them
# Outlook is off.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: Gmail push through Pub/Sub, and the token its push subscription sends.
GMAIL_PUBSUB_TOPIC=
GMAIL_HOOK_TOKEN=
# Optional: the APNs auth key (the .p8's text), its id and the team's, to push new mail to iPhones.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
# Optional: the Firebase service account's JSON key (its text), to push new mail to Android phones.
FCM_SERVICE_ACCOUNT=
# Sessions without an account, for tests and local work only.
DEV_LOGIN=1
