---
import {
  BellIcon,
  ClockIcon,
  KeyboardIcon,
  LayersIcon,
  ShieldCheckIcon,
  ZapIcon,
} from "lucide-react"
import Layout from "@/layouts/main.astro"
import GithubIcon from "@/components/github-icon.astro"
import LinkButton from "@/components/link-button.astro"
import { Demo } from "@/components/demo/demo"
import { DownloadButton } from "@/components/download-button"
import {
  DESCRIPTION,
  GETTING_STARTED_URL,
  GITHUB_URL,
  TAGLINE,
} from "@/lib/links"

const features = [
  {
    icon: ZapIcon,
    title: "Nothing waits",
    text: "Your mail lives on your device. Opening, archiving and searching happen at once, and a server syncs with your provider in the background.",
  },
  {
    icon: LayersIcon,
    title: "Gmail, Outlook and JMAP",
    text: "Gmail, Outlook, Fastmail and any JMAP server in one unified inbox, each account with a colour of its own.",
  },
  {
    icon: KeyboardIcon,
    title: "Single keys",
    text: "j and k to move, e to archive, r to reply, and ⌘K for every command. Any key can be changed in the settings.",
  },
  {
    icon: ClockIcon,
    title: "Newton's habits",
    text: "Snooze, send later, remind me and undo send. A split inbox keeps people apart from newsletters.",
  },
  {
    icon: BellIcon,
    title: "Sealed notifications",
    text: "New mail reaches your phone sealed with a key only it holds, so Apple and Google carry nothing they can read.",
  },
  {
    icon: ShieldCheckIcon,
    title: "Private by default",
    text: "Remote images stay blocked until you ask for them, and every message is sanitized before it is drawn.",
  },
]
---

<Layout>
  <main class="overflow-x-clip pb-24">
    <section class="mx-auto flex max-w-5xl flex-col items-center px-6 pt-10 text-center sm:pt-14">
      <h1 class="max-w-[16ch] text-4xl leading-[1.05] font-medium tracking-tight text-balance sm:text-6xl">
        {TAGLINE}
      </h1>
      <p class="mt-5 max-w-md text-lg text-pretty text-muted-foreground">
        {DESCRIPTION}
      </p>
      <DownloadButton client:load>
        <LinkButton href={GITHUB_URL} size="lg" variant="outline">
          <GithubIcon />
          View the source
        </LinkButton>
      </DownloadButton>
      <p class="mt-4 text-sm text-muted-foreground">Free and open source.</p>
    </section>

    <section class="mx-auto mt-10 max-w-[1248px] px-3 sm:mt-14 sm:px-6">
      <div data-demo-frame>
        <Demo client:load />
      </div>
      <script is:inline>
        // Safari can paint a stale cqw, so the demo's scale is measured before the first paint.
        {
          const frame = document.querySelector("[data-demo-frame]")
          const fit = () =>
            frame.style.setProperty(
              "--demo-fit",
              Math.min(1, frame.clientWidth / 1200)
            )
          fit()
          new ResizeObserver(fit).observe(frame)
        }
      </script>
      <p class="mt-5 text-center text-sm text-pretty text-muted-foreground">
        A live demo. Open a thread, or click in and try j and k, e to archive, h
        to snooze and c to write.
      </p>
    </section>

    <section class="mx-auto mt-24 grid max-w-5xl gap-x-10 gap-y-12 px-6 sm:mt-32 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <div>
          <feature.icon className="size-5" />
          <h2 class="mt-4 font-medium">{feature.title}</h2>
          <p class="mt-1.5 text-pretty text-muted-foreground">{feature.text}</p>
        </div>
      ))}
    </section>

    <section class="mx-auto mt-24 flex max-w-5xl flex-col items-center px-6 text-center sm:mt-32">
      <h2 class="text-2xl font-medium tracking-tight">Open source</h2>
      <p class="mt-3 max-w-md text-pretty text-muted-foreground">
        Wonnet is MIT licensed. The apps start on our server, and you can run
        your own with Postgres and a single binary.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <LinkButton href={GITHUB_URL} variant="outline">
          <GithubIcon />
          yekta/wonnet
        </LinkButton>
        <LinkButton href={GETTING_STARTED_URL} variant="ghost">
          Run your own server
        </LinkButton>
      </div>
    </section>
  </main>
</Layout>
