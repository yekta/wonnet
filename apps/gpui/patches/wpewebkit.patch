+String helperDirectory()
+{
+    Dl_info info;
+    if (!dladdr(reinterpret_cast<void*>(&helperDirectory), &info) || !info.dli_fname)
+        return { };
+    String library = FileSystem::stringFromFileSystemRepresentation(info.dli_fname);
+    return FileSystem::pathByAppendingComponent(FileSystem::parentPath(library), "wpe-webkit-2.0"_s);
+}
+
 static String findWebKitProcess(const ASCIILiteral processName)
 {
+    String besideLibrary = FileSystem::pathByAppendingComponent(helperDirectory(), processName);
+    if (FileSystem::fileExists(besideLibrary))
+        return besideLibrary;
+
